# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files and secrets
.env*
!.env.example

# private source data (never commit survey exports)
/data/private/
/feedback-survey-export.xlsx
*.numbers

# private development-process material
/AGENTS.md
/CLAUDE.md
/docs/checkpoints/
/docs/training-evidence/
/docs/assignment-*-evidence.md

# vercel
.vercel

# supabase local CLI state
/supabase/.temp/
/supabase/.branches/

# typescript
*.tsbuildinfo
next-env.d.ts
